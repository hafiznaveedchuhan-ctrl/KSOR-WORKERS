OPENAI_API_KEY=your-key-here
MCP_URL=http://127.0.0.1:8080/mcp
REFUND_GATE_THRESHOLD=5000
# Optional: seconds to wait for a human decision before escalating (default 86400 = 24h)
# REFUND_GATE_TIMEOUT_SECONDS=86400
# Inngest defaults to the local dev server (npx inngest-cli@latest dev). For
# production set INNGEST_SIGNING_KEY and INNGEST_EVENT_KEY instead.
